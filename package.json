{
  "name": "gr-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local",
    "smoke:local": "node --env-file-if-exists=.env.smoke.local scripts/smoke-real-integration.mjs",
    "build": "ng build",
    "serve:production": "node scripts/serve-production.mjs",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --runner-config=vitest.config.ts",
    "check": "npm run typecheck:app && npm run typecheck:spec && npm test && npm run build"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/angular": "^1.46.0",
    "@supabase/supabase-js": "^2.116.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.13",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@angular/build": {
      "@babel/core": "7.29.7",
      "esbuild": "0.28.1",
      "piscina": "5.2.0",
      "undici": "7.29.0",
      "vite": "7.3.6"
    }
  }
}
